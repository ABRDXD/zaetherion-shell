diff --git a/src/core/qsintercept.cpp b/src/core/qsintercept.cpp
index 6687681..10e9bf7 100644
--- a/src/core/qsintercept.cpp
+++ b/src/core/qsintercept.cpp
@@ -2,6 +2,7 @@
 #include <cstring>
 
 #include <qdir.h>
+#include <qfileinfo.h>
 #include <qhash.h>
 #include <qiodevice.h>
 #include <qlogging.h>
@@ -64,6 +65,17 @@ QUrl QsUrlInterceptor::intercept(
 			qCDebug(logQsIntercept) << "Rewrote intercept" << url << "to" << newUrl;
 			return newUrl;
 		}
+
+		// Experiment (#1434): a .qml file with no in-memory override, in a folder with a real
+		// qmldir on disk, loads as file:// so Qt's QML disk cache can apply to it.
+		if (type == QQmlAbstractUrlInterceptor::DataType::QmlFile && path.endsWith(".qml")
+		    && !this->fileIntercepts.contains(path)
+		    && QFileInfo::exists(QFileInfo(path).dir().filePath("qmldir")))
+		{
+			auto newUrl = QUrl::fromLocalFile(path);
+			qCDebug(logQsIntercept) << "Rewrote qml file intercept" << url << "to" << newUrl;
+			return newUrl;
+		}
 	}
 
 	return url;
