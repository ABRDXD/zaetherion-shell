#!/bin/sh
# ZÆTHERION session starter, run once by Hyprland at login (~/.config/hypr/zaetherion/session.lua).
# Starts the core (fartd), which supervises DMS (docs/SUPERVISOR.md), and on logout stops it, so no
# processes are left behind.
ROOT=$(dirname "$(dirname "$(readlink -f "$0")")")
RUN=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
LOG_DIR=$RUN/zaetherion
mkdir -p "$LOG_DIR"
LOG=$LOG_DIR/session.log
SOCK=$RUN/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket.sock

say() { echo "$(date '+%F %T') $*" >>"$LOG"; }

# Only one starter per Hyprland instance.
exec 9>"$LOG_DIR/session.lock"
flock -n 9 || { say "another session starter is running; leaving"; exit 0; }

say "session start (Hyprland $HYPRLAND_INSTANCE_SIGNATURE)"
"$ROOT/zaetherion" start >>"$LOG" 2>&1 || say "core did not start"

# The core (fartd) supervises DMS itself (FART_SUPERVISE=dms, set by `zaetherion start`): it starts it,
# restarts it with backoff, and ends it with the compositor. This script only waits for the session to end.
alive() { [ -S "$SOCK" ]; }
stop_all() {
    say "session end: stopping the core (and DMS with it)"
    "$ROOT/zaetherion" stop >>"$LOG" 2>&1
    # Leave a record for the next login: anything of ours still running after the stop.
    left=$(pgrep -u "$(id -u)" -a -f 'dms run|dms-shell|core/fartd.py' 2>/dev/null | grep -v "pgrep")
    if [ -n "$left" ]; then KEEP="LEFTOVER after stop: $left"; else KEEP="logout check: nothing left"; fi
    say "$KEEP"
    # The runtime folder goes with the session, so keep the record where it survives.
    mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}/zaetherion" && echo "$(date '+%F %T') $KEEP" >>"${XDG_STATE_HOME:-$HOME/.local/state}/zaetherion/logout.log"
    exit 0
}
trap stop_all TERM INT HUP

while alive; do
    sleep 2
done
stop_all
